{
  "name": "@fp/persistence",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p prisma/tsconfig.json"
  },
  "dependencies": {
    "@fp/core": "workspace:*",
    "@fp/kernel": "workspace:*",
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@fp/config-eslint": "workspace:*",
    "@fp/config-typescript": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.1",
    "prisma": "^6.16.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
