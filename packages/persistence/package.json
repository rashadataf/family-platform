{
  "name": "@fp/persistence",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@fp/config-eslint": "workspace:*",
    "@fp/config-typescript": "workspace:*",
    "eslint": "^9.39.1",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  }
}
