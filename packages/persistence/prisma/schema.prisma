generator client {
  provider = "prisma-client-js"
  // Generated into this package rather than into node_modules/.prisma.
  //
  // The default location is not carried by `pnpm deploy --prod`: the pruned
  // tree gets a fresh, ungenerated @prisma/client, and the container then dies
  // at import with "does not provide an export named 'PrismaClient'". Copying
  // the generated directory across pnpm virtual-store paths in the Dockerfile
  // would work but is fragile — it hard-codes store layout.
  //
  // Generating here makes the client part of @fp/persistence's own build
  // output, so it ships wherever the package ships. Prisma is also moving to
  // require an explicit output, so this is the direction of travel anyway.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Identity and Access (spec 006, data-model.md). The platform's first real
// domain schema — `ScaffoldProbe` is retired in this same migration per its
// own comment's instruction ("MUST be deleted once the first real domain
// migration lands").
//
// Email case-insensitivity (FR-022) is enforced by normalising in the domain
// layer (packages/core/identity/domain/email-address.vo.ts) before any write
// or read reaches this schema, rather than by a Postgres `citext` column —
// the repository is the only writer, so a plain unique index on the
// already-normalised value gives the same guarantee without an extension.
model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(pending_verification)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  deletionRequestedAt DateTime?  @map("deletion_requested_at")
  failedAttemptCount  Int        @default(0) @map("failed_attempt_count")
  throttledUntil      DateTime?  @map("throttled_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sessions           Session[]
  devices            Device[]
  emailVerifications EmailVerification[]

  @@map("user")
}

enum UserStatus {
  pending_verification
  active
  deletion_requested

  @@map("user_status")
}

model Session {
  id                String                @id @default(uuid())
  userId            String                @map("user_id")
  deviceId          String                @map("device_id")
  tokenHash         Bytes                 @unique @map("token_hash")
  previousTokenHash Bytes?                @map("previous_token_hash")
  issuedAt          DateTime              @default(now()) @map("issued_at")
  rotatedAt         DateTime?             @map("rotated_at")
  absoluteExpiresAt DateTime              @map("absolute_expires_at")
  revokedAt         DateTime?             @map("revoked_at")
  revokedReason     SessionRevokedReason? @map("revoked_reason")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // A user listing their own sessions is a routine query (data-model.md).
  @@index([userId])
  // Replay detection looks a presented token up against the immediately
  // superseded hash (FR-011).
  @@index([previousTokenHash])
  @@map("session")
}

enum SessionRevokedReason {
  user_revoked
  account_deleted
  replay_detected

  @@map("session_revoked_reason")
}

model Device {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  label       String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("device")
}

model EmailVerification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    Bytes     @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  supersededAt DateTime? @map("superseded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification")
}

// No foreign key to User, on purpose (data-model.md): this table must
// survive the erasure of the account it refers to, carrying only an
// identifier. A foreign key would either block erasure or cascade away the
// audit trail, and both are wrong (ADR-005 Layer 2).
model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  correlationId String    @map("correlation_id")

  // The oldest unpublished row is the single most important operational
  // metric in the system (constitution, ADR-005).
  @@index([publishedAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Family and Membership (spec 008, ARCHITECTURE.md §5.2) — the tenant root.
//
// Every model in this block except `AuditLog` is FAMILY-SCOPED: it carries
// `family_id`, and the migration places it under ENABLE + FORCE ROW LEVEL
// SECURITY with a policy keyed on `current_setting('app.family_id')`
// (ADR-017). Adding a family-scoped table here without those three things is
// a Principle V violation, not an oversight to fix later.
//
// UUIDv7 (ARCHITECTURE.md §10): time-ordered, so these index well and do not
// fragment B-trees. Identity's tables above use v4 — pre-existing drift,
// recorded in spec 008 research.md §9 and deliberately not fixed here, since
// changing a generator on a populated table is expand-and-contract work.
// ---------------------------------------------------------------------------

model Family {
  id String @id @default(uuid(7))

  name String

  // The household profile downstream contexts read (ARCHITECTURE.md §5.2).
  // `localAuthorityCode` is an IDENTIFIER, never a council name — the
  // constitution's UK-first-without-being-UK-welded constraint. Neither is
  // validated against real reference data here; that is Reference and Locale.
  postcode           String?
  localAuthorityCode String? @map("local_authority_code")
  composition        Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Set by FamilyDeletionRequested (FR-023). Non-null revokes every member's
  // access immediately; the erasure itself follows the Compliance saga's
  // grace period. Write-once, enforced in the domain.
  deletionRequestedAt DateTime? @map("deletion_requested_at")

  members        FamilyMember[]
  invitations    Invitation[]
  guardianships  Guardianship[]
  calendarEvents CalendarEvent[]
  tasks          Task[]

  @@map("family")
}

// The privacy discriminator (spec 008 research.md §5). Orthogonal to
// `MemberRole`: ARCHITECTURE.md §9 speaks of a member "marked as" a child,
// and a child is not a fifth role because a role answers what a person may
// do — and a child has no login path through which to do anything.
enum MemberKind {
  adult
  child

  @@map("member_kind")
}

// The four coarse roles of ARCHITECTURE.md §5.2. Code checks capabilities,
// never these values (FR-015); the mapping lives in
// packages/core/src/family/domain/capabilities.ts.
enum MemberRole {
  owner
  adult
  extended
  viewer

  @@map("member_role")
}

/// A person the family tracks — NOT a `User`. The most important modelling
/// decision in the system (ARCHITECTURE.md §5.2). A child is a member with no
/// `userId`, no credentials and no login path at all: that is the privacy
/// design, not a shortcut, and the CHECK constraints in this table's migration
/// are what make it true against a raw query as well as against the domain.
model FamilyMember {
  id       String @id @default(uuid(7))
  familyId String @map("family_id")

  kind MemberKind
  role MemberRole

  // The link to Identity. No foreign key, deliberately (ARCHITECTURE.md §10):
  // cross-context references are to published stable ids only, and a foreign
  // key would let identity's erasure cascade a family's member row away.
  userId String? @map("user_id")

  // Personal data. Two fields, each justified in spec 008's Personal Data
  // section — nothing else is collected here (Principle VI). Both are nulled
  // by `eraseForMember`, which is why they are nullable; a CHECK requires
  // `displayName` on any member that has not been removed.
  displayName String?   @map("display_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  removedAt DateTime? @map("removed_at")

  family              Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sentInvitations     Invitation[]       @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[]       @relation("InvitationAcceptedBy")
  guardianOf          Guardianship[]     @relation("GuardianshipGuardian")
  guardedBy           Guardianship[]     @relation("GuardianshipChild")
  calendarEvents      EventParticipant[]
  taskAssignments     TaskAssignment[]

  // Spec 009: redundant against the primary key, and what lets
  // `event_participant`'s composite foreign key prove a participant belongs to
  // the SAME family as the event (FR-018) — a plain FK on `member_id` would not,
  // because foreign-key checks are not subject to row-level security.
  @@unique([id, familyId])
  // `FamilyContextPort.resolve(userId, familyId)` runs in the guard on every
  // family-scoped request, ahead of everything else (research.md §12).
  @@index([userId])
  @@index([familyId])
  @@map("family_member")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

/// An offer for one email address to join one family. The token is stored only
/// as a hash, exactly as spec 006 handles verification tokens — the raw value
/// exists in the recipient's inbox and nowhere else.
model Invitation {
  id       String @id @default(uuid(7))
  familyId String @map("family_id")

  // Normalised by `EmailAddress` before it reaches here. Nullable because
  // retention removes it 90 days after the invitation is settled, while the
  // record itself survives a little longer.
  email String?

  proposedRole MemberRole       @map("proposed_role")
  tokenHash    Bytes            @unique @map("token_hash")
  status       InvitationStatus @default(pending)
  expiresAt    DateTime         @map("expires_at")

  invitedByMemberId  String  @map("invited_by_member_id")
  acceptedByMemberId String? @map("accepted_by_member_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")

  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy  FamilyMember  @relation("InvitationInvitedBy", fields: [invitedByMemberId], references: [id], onDelete: Cascade)
  acceptedBy FamilyMember? @relation("InvitationAcceptedBy", fields: [acceptedByMemberId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([familyId])
  @@map("invitation")
}

/// Guardianship is EXPLICIT, never inferred from membership (FR-004,
/// Principle VI). `familyId` is denormalised rather than derived through
/// either member because ARCHITECTURE.md §10 requires the tenant key to be
/// present and not join-derived — a join-derived tenant key is one that can be
/// forgotten.
model Guardianship {
  id       String @id @default(uuid(7))
  familyId String @map("family_id")

  guardianMemberId String @map("guardian_member_id")
  childMemberId    String @map("child_member_id")

  establishedAt DateTime  @default(now()) @map("established_at")
  endedAt       DateTime? @map("ended_at")

  family   Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardian FamilyMember @relation("GuardianshipGuardian", fields: [guardianMemberId], references: [id], onDelete: Cascade)
  child    FamilyMember @relation("GuardianshipChild", fields: [childMemberId], references: [id], onDelete: Cascade)

  // The guardian-count check on every mutation, and the access check on every
  // read of a child's details.
  @@index([childMemberId])
  @@index([guardianMemberId])
  @@map("guardianship")
}

// ---------------------------------------------------------------------------
// Calendar (spec 009, ARCHITECTURE.md §5.3) — the first context built on top
// of the tenant root rather than beside it.
//
// Every model here is FAMILY-SCOPED and sits under ENABLE + FORCE ROW LEVEL
// SECURITY in its migration, exactly as the Family block above does (ADR-017).
// `calendar_event` is authored; `event_occurrence` is derived, with exactly one
// authored attribute — an individual cancellation — which is why its rebuild
// is a reconcile rather than a regenerate (data-model.md).
//
// Instants are `timestamptz`, unlike the Family block's `timestamp`: this is
// the context whose correctness is measured in wall-clock time across a clock
// change, and the constitution's "UTC with time zone" is not negotiable here.
// ---------------------------------------------------------------------------

/// The discriminant of the timed | all-day union. The CHECK constraints in the
/// migration make "an all-day event with a start time" unrepresentable against
/// a raw query too, not only in the domain (Principle I).
enum EventKind {
  timed
  all_day

  @@map("event_kind")
}

/// Platform-defined, never family-authored text, so a category carries no
/// personal data and later contexts can reason about it (spec.md Assumptions).
enum EventCategory {
  medical
  school
  nursery
  activity
  birthday
  holiday
  deadline
  social
  household
  other

  @@map("event_category")
}

/// A cancelled event keeps its slot (FR-021). There is no `deleted`.
enum EventStatus {
  confirmed
  cancelled

  @@map("event_status")
}

/// The record of truth. Every occurrence is derived from it.
model CalendarEvent {
  id       String @id @default(uuid(7))
  familyId String @map("family_id")

  // Personal data (spec.md Principle XI answer 1). Free text, never parsed,
  // never logged, never put in an outbox payload.
  title       String
  description String?
  location    String?

  kind      EventKind
  // Set for `timed`, null for `all_day` — and the reverse below. The
  // `event_shape` CHECK enforces the pairing.
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  /// IANA identifier, validated against the runtime's zone set. NOT NULL even
  /// for all-day events: the constitution requires the authored zone be kept.
  timeZone  String    @map("time_zone")

  category       EventCategory?
  /// The canonical serialisation of the parsed rule (`RecurrenceRule.toString`).
  recurrenceRule String?        @map("recurrence_rule")
  /// FR-031: opaque references into a context that does not exist yet. Never
  /// validated, resolved or dereferenced.
  attachmentRefs String[]       @default([]) @map("attachment_refs")
  status         EventStatus    @default(confirmed)

  /// How far this series' occurrences reach. Null when there is nothing
  /// further to materialise — a one-off, or a series whose COUNT/UNTIL has
  /// already ended — so `min()` over it is the horizon-lag gauge (FR-026).
  materialisedThrough DateTime? @map("materialised_through") @db.Timestamptz(3)

  /// No foreign key: member erasure tombstones the member row, so this never
  /// dangles, and a key would let a hard delete cascade a family's history away.
  createdByMemberId String? @map("created_by_member_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  occurrences  EventOccurrence[]
  participants EventParticipant[]

  // Redundant against the primary key; the price of letting the two children
  // below denormalise `family_id` without it ever being able to drift.
  @@unique([id, familyId])
  // The materialisation sweep's claim query (research.md §8).
  @@index([materialisedThrough])
  @@map("calendar_event")
}

/// Derived data with one authored attribute (`cancelledAt`, FR-022).
model EventOccurrence {
  id       String @id @default(uuid(7))
  /// Denormalised so the RLS policy needs no join on the one query in this
  /// feature that must stay cheap. The composite FK below keeps it honest.
  familyId String @map("family_id")
  eventId  String @map("event_id")

  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  event CalendarEvent @relation(fields: [eventId, familyId], references: [id, familyId], onDelete: Cascade)

  /// THE identity. The sweep is idempotent because re-expanding a rule finds
  /// the same rows here and inserts nothing (FR-025, research.md §5).
  @@unique([eventId, startsAt])
  /// The range query (research.md §7).
  @@index([familyId, startsAt, endsAt])
  @@map("event_occurrence")
}

/// A member id and a timestamp — and nothing else about the person. No kind,
/// no age, no guardianship: FR-016 is answered by asking Family who may be
/// seen, not by caching a classification here (research.md §1).
model EventParticipant {
  eventId  String @map("event_id")
  familyId String @map("family_id")
  memberId String @map("member_id")

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  event  CalendarEvent @relation(fields: [eventId, familyId], references: [id, familyId], onDelete: Cascade)
  /// FR-018 as a key, not only a check: the member must exist in THIS family.
  member FamilyMember  @relation(fields: [memberId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([eventId, memberId])
  /// Erasure, and the visibility filter's anti-join.
  @@index([memberId])
  @@map("event_participant")
}

// ---------------------------------------------------------------------------
// Audit and Compliance (ARCHITECTURE.md §5.12) — owned by that context, NOT by
// Family, and DELIBERATELY NOT FAMILY-SCOPED.
//
// It has no row-level security policy on purpose. A denial is frequently
// recorded when `app.family_id` is unset or names a different family — exactly
// the row a policy would discard, and exactly the row that matters. Its
// isolation is a grant instead: the application role holds INSERT and nothing
// else, which is §5.12's "append-only, no update or delete grants" expressed
// as a grant rather than as a convention (ADR-017, spec 008 research.md §7).
//
// Do not "fix" this by adding a policy. See ADR-017's "What is explicitly
// outside the policy set".
// ---------------------------------------------------------------------------

enum AuditResult {
  granted
  denied

  @@map("audit_result")
}

/// Append-only. No foreign keys anywhere: this table must survive the erasure
/// of everything it refers to, carrying identifiers only. Erasing the record of
/// who read a child's file would defeat the control that produced it.
model AuditLog {
  id         String   @id @default(uuid(7))
  occurredAt DateTime @default(now()) @map("occurred_at")

  actorUserId   String? @map("actor_user_id")
  // Null when the actor had no standing in the family — which is itself the
  // finding, not missing data.
  actorMemberId String? @map("actor_member_id")
  familyId      String? @map("family_id")

  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  action  String
  /// Principle VI names purpose explicitly as a required field on a child-record read.
  purpose String
  result  AuditResult
  /// The REAL reason, including the one the caller was not told (FR-021).
  reason  String?

  correlationId String @map("correlation_id")

  @@index([subjectId, occurredAt])
  @@index([familyId, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Idempotency (ADR-006, Constitution Principle IX) — a platform mechanism,
// not owned by any one bounded context, the same way the outbox is not.
//
// `POST /v1/families` is the first route that genuinely needs it: unlike
// registration (a duplicate is caught for free by the email unique
// constraint), creating a family twice with the same body has no natural
// dedup — nothing stops it. Scoped by `userId` rather than by family, because
// the whole point is to protect the ONE creating call for which no family
// exists yet to scope to.
//
// No foreign key to `User`: an idempotency record's job is to survive exactly
// as long as its own short retry window, never as long as the account. A
// future sweep deleting rows past that window (not yet written — nothing
// depends on it existing yet) is the intended lifecycle, not account
// deletion.
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  key    String

  /// Detects a caller reusing the same key for a genuinely different request
  /// (a client bug, not a retry) — the response is meaningless to replay then.
  requestHash    String @map("request_hash")
  responseStatus Int    @map("response_status")
  responseBody   Json   @map("response_body")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// Tasks (spec 010, ARCHITECTURE.md §5.4). Two family-scoped tables under
// ENABLE + FORCE row-level security (ADR-017), declared in the migration.
//
// Every instance of a recurring chore is its own `task` row: there is no
// series table and no materialised future. A series is a shared `series_id`,
// a `predecessor_id` chain, and exactly one row flagged `is_series_head`
// (data-model.md). The partial unique index that makes "exactly one head"
// true, the list and sweep indexes, and the shape CHECKs are hand-written in
// the migration, because Prisma's schema language cannot express them.
// ---------------------------------------------------------------------------

enum TaskStatus {
  open
  completed
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  normal
  high

  @@map("task_priority")
}

enum TaskCategory {
  household
  school
  health
  finance
  admin
  other

  @@map("task_category")
}

enum TaskDueKind {
  none
  date
  date_time

  @@map("task_due_kind")
}

model Task {
  id       String @id @default(uuid(7))
  familyId String @map("family_id")

  // Personal data (spec.md Principle XI answer 1). Free text, never parsed,
  // never logged, never put in an outbox payload or an audit purpose.
  title String
  notes String?

  priority TaskPriority  @default(normal)
  category TaskCategory?
  status   TaskStatus    @default(open)

  /// The due-date discriminant. `task_due_shape` pairs it with the columns below.
  dueKind      TaskDueKind @default(none) @map("due_kind")
  dueDate      DateTime?   @map("due_date") @db.Date
  dueLocalTime DateTime?   @map("due_local_time") @db.Time(0)
  /// IANA identifier; set whenever there is a due date.
  timeZone     String?     @map("time_zone")
  /// DERIVED due moment, written by the domain: the end of `due_date` for a
  /// date-only due, the resolved instant otherwise (research.md §4).
  dueAt        DateTime?   @map("due_at") @db.Timestamptz(3)

  /// Canonical serialisation of the parsed rule (`RecurrenceRule.toString`).
  recurrenceRule   String?   @map("recurrence_rule")
  /// Local wall-clock reading (no zone) the rule is counted from (research.md §2).
  recurrenceAnchor DateTime? @map("recurrence_anchor") @db.Timestamp(0)
  seriesId         String?   @map("series_id")
  /// FR-022 as a key: one successor per instance.
  predecessorId    String?   @unique @map("predecessor_id")
  /// FR-019: exactly one head per series, by a partial unique index in the migration.
  isSeriesHead     Boolean   @default(false) @map("is_series_head")

  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByMemberId String?   @map("completed_by_member_id")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledByMemberId String?   @map("cancelled_by_member_id")
  /// `coalesce(completed_at, cancelled_at)`, kept equal by a CHECK; the history index's key.
  closedAt            DateTime? @map("closed_at") @db.Timestamptz(3)

  /// The `due_at` last reported overdue (research.md §5).
  overdueReportedFor DateTime? @map("overdue_reported_for") @db.Timestamptz(3)

  /// No foreign key, as Calendar's: member erasure tombstones the member row.
  createdByMemberId String? @map("created_by_member_id")

  /// FR-011: optimistic concurrency.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  predecessor Task?            @relation("TaskSuccession", fields: [predecessorId], references: [id], onDelete: SetNull)
  successor   Task?            @relation("TaskSuccession")
  assignments TaskAssignment[]

  // Redundant against the primary key; what `task_assignment`'s composite
  // foreign key references, so its denormalised `family_id` cannot drift.
  @@unique([id, familyId])
  @@map("task")
}

model TaskAssignment {
  taskId   String @map("task_id")
  familyId String @map("family_id")
  memberId String @map("member_id")

  assignedAt         DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  /// Tombstoned on member erasure.
  assignedByMemberId String?  @map("assigned_by_member_id")

  task   Task         @relation(fields: [taskId, familyId], references: [id, familyId], onDelete: Cascade)
  /// FR-016 as a key: the assignee must be a member of THIS family.
  member FamilyMember @relation(fields: [memberId, familyId], references: [id, familyId], onDelete: Cascade)

  @@id([taskId, memberId])
  /// The assignee filter, the visibility anti-join, and erasure.
  @@index([memberId])
  @@map("task_assignment")
}

// ---------------------------------------------------------------------------
// Outbox relay (spec 011, ADR-005 Layer 3) — the consumer-side idempotency
// ledger ARCHITECTURE.md §7.3's sequence diagram names `processed_events`,
// keyed on the queue as well as the event so two different consumers reading
// the same queue never share one ledger entry.
//
// Not family-scoped, no RLS: mirrors `IdempotencyKey`'s existing exception —
// this table records delivery facts about the messaging mechanism, not
// anything about a family.
//
// No foreign key to `outbox_event`: a consumer in a later feature may run
// against a different database, or the source row may be long gone; the
// idempotency check must not depend on the source row still existing.
// ---------------------------------------------------------------------------

model ProcessedEvent {
  id          String   @id @default(uuid(7))
  queueName   String   @map("queue_name")
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([queueName, eventId])
  @@map("processed_event")
}
