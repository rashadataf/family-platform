generator client {
  provider = "prisma-client-js"
  // Generated into this package rather than into node_modules/.prisma.
  //
  // The default location is not carried by `pnpm deploy --prod`: the pruned
  // tree gets a fresh, ungenerated @prisma/client, and the container then dies
  // at import with "does not provide an export named 'PrismaClient'". Copying
  // the generated directory across pnpm virtual-store paths in the Dockerfile
  // would work but is fragile — it hard-codes store layout.
  //
  // Generating here makes the client part of @fp/persistence's own build
  // output, so it ships wherever the package ships. Prisma is also moving to
  // require an explicit output, so this is the direction of travel anyway.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Scaffolding only. This table exists to prove the migration mechanism
// builds schema from nothing (see specs/001-monorepo-dev-environment/spec.md
// FR-005) and to back the API's /health/ready check. It is not product
// domain schema and MUST be deleted once the first real domain migration
// lands in a later feature.
model ScaffoldProbe {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  // Added purely to exercise T024's "a real migration applies automatically
  // on redeploy" verification (spec 003) — no functional use.
  note      String?

  @@map("_scaffold_probe")
}
