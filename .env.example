# Copy this file to `.env` and adjust values as needed for local development.
# `.env` is git-ignored; this file is the committed template (FR-006).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Must stay in sync with the values baked into DATABASE_URL below.
POSTGRES_PORT=5432
POSTGRES_DB=family_platform

# Three connection strings, three roles, on purpose (ADR-017).
#
#   DATABASE_URL            the APPLICATION role. What apps/api and apps/worker
#                           hold, and the only one subject to row-level
#                           security. The API refuses to boot if this connects
#                           as anyone else.
#   MIGRATOR_DATABASE_URL   the OWNER role. Runs migrations and the seed
#                           fixture. Non-superuser, so `FORCE ROW LEVEL
#                           SECURITY` constrains it too.
#   BOOTSTRAP_DATABASE_URL  the cluster superuser. Used by ONE step —
#                           `db:provision-roles`, which creates the two roles
#                           above — and by nothing else. A superuser bypasses
#                           row-level security unconditionally and no table
#                           setting can change that, so nothing long-running
#                           may hold this.
#
# Host/port/db here must match the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://family_platform_app:appdev@localhost:5432/family_platform
MIGRATOR_DATABASE_URL=postgresql://family_platform_owner:ownerdev@localhost:5432/family_platform
BOOTSTRAP_DATABASE_URL=postgresql://postgres:localdev@localhost:5432/family_platform

# Passwords the bootstrap step assigns to the two roles it creates. Local
# development values only — staging and production resolve these from the
# secret store at runtime (Principle X), never from a committed file.
DB_OWNER_PASSWORD=ownerdev
DB_APP_PASSWORD=appdev

# Stage 0 mail sink (research.md §4). Points at the mailpit service in
# docker-compose.yml; its browsable inbox is at http://localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025

# Stage 0 event transport (ADR-018, spec 011). Points at the elasticmq service
# in docker-compose.yml. As with DATABASE_URL, these are the HOST values: inside
# the Compose network the worker is given `elasticmq` as the hostname instead.
# Needed by `pnpm test:integration` and by relay:seed / relay:peek run on the
# host. At Stage 1 the same two variables name real SQS — no code changes.
RELAY_QUEUE_ENDPOINT=http://localhost:9324
RELAY_QUEUE_REGION=elasticmq

# Not secrets. The AWS SDK refuses to send a request with no credentials
# configured at all, and ElasticMQ does not check them, so any non-empty value
# satisfies both. Stage 1 supplies real ones from its deployment secret store,
# never from a committed file (Principle X).
AWS_ACCESS_KEY_ID=elasticmq-placeholder
AWS_SECRET_ACCESS_KEY=elasticmq-placeholder
