# Copy this file to `.env` and adjust values as needed for local development.
# `.env` is git-ignored; this file is the committed template (FR-006).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Must stay in sync with the values baked into DATABASE_URL below.
POSTGRES_PORT=5432
POSTGRES_DB=family_platform

# Full connection string used by Prisma and the API. Host/port/db/user/password
# here must match the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/family_platform
