{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["src/**", "eslint.config.js", "package.json"],
      "outputs": []
    },

    "//#typecheck:workspace-root": {
      "inputs": [
        "scripts/**",
        "scripts/tsconfig.json",
        "apps/api/src/config/env.schema.ts",
        "apps/api/src/config/load-env.ts",
        "package.json"
      ],
      "outputs": []
    },
    "//#lint:workspace-root": {
      "inputs": ["scripts/**", "eslint.config.js", "package.json"],
      "outputs": []
    },
    "//#boundaries": {
      "inputs": ["apps/**", "packages/**", "scripts/**", ".dependency-cruiser.cjs", "package.json"],
      "outputs": []
    },

    // infrastructure/'s entrypoint is index.ts, at the package root (Pulumi's
    // own convention) rather than under src/ like every other package's
    // default `typecheck`/`lint` inputs assume — without this override,
    // turbo's cache would not invalidate when index.ts changes.
    "infrastructure#typecheck": {
      "dependsOn": [],
      "inputs": ["index.ts", "src/**", "tsconfig.json"],
      "outputs": []
    },
    "infrastructure#lint": {
      "dependsOn": [],
      "inputs": ["index.ts", "src/**", "eslint.config.js", "package.json"],
      "outputs": []
    }
  }
}
