node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
coverage/
.DS_Store
packages/persistence/src/generated/

# infrastructure/src/image.ts's `docker save` step (spec 003) writes these
# next to the Pulumi program on whichever machine runs `pulumi up` — build
# artifacts regenerated on every deploy, never meant to be committed.
infrastructure/*.tar

# The seeded design canvas (design/*.html) embeds a ~2MB copy of the canvas
# editor alongside the artboards, and it is regenerated in full by the seed
# step on every change. The artboard sources next to it (design/*.dc.html and
# design/canvas.json) ARE tracked — they are what the canvas is rebuilt from,
# and a token change is meant to read as a reviewable diff.
design/*.html
!design/*.dc.html

# Expo tooling output (apps/mobile, spec 007) — regenerated by `expo start`
# and the native build tooling; never hand-edited, never committed.
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/*.jks
apps/mobile/*.p8
apps/mobile/*.p12
apps/mobile/*.key
apps/mobile/*.mobileprovision
