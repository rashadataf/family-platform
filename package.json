{
  "name": "family-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "prettier": "@fp/config-prettier",
  "scripts": {
    "dev": "dotenv -e .env -- tsx scripts/dev.ts",
    "dev:down": "docker compose down",
    "db:reset": "dotenv -e .env -- tsx scripts/db-reset.ts",
    "db:migrate:create": "pnpm --filter @fp/persistence exec prisma migrate dev",
    "postinstall": "pnpm --filter @fp/persistence run db:generate",
    "verify:env": "tsx scripts/verify-env-example.ts",
    "verify:node-version": "tsx scripts/verify-node-version.ts",
    "verify:action-pins": "tsx scripts/verify-action-pins.ts",
    "verify:suppressions": "tsx scripts/verify-suppressions.ts",
    "typecheck": "turbo run typecheck typecheck:workspace-root",
    "typecheck:workspace-root": "tsc -p scripts/tsconfig.json",
    "lint": "turbo run lint lint:workspace-root",
    "lint:workspace-root": "eslint . --max-warnings 0",
    "boundaries": "tsx scripts/boundaries.ts",
    "test": "turbo run test test:workspace-root",
    "test:workspace-root": "vitest run --dir scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo build",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test && pnpm format:check && pnpm verify:env && pnpm verify:node-version && pnpm verify:action-pins && pnpm verify:suppressions && pnpm build"
  },
  "devDependencies": {
    "@fp/config-eslint": "workspace:*",
    "@fp/config-prettier": "workspace:*",
    "@fp/config-typescript": "workspace:*",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "zod": "^3.24.1"
  }
}
