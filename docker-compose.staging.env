# Transferred to the VPS as `.env` (infrastructure/src/transfer.ts), so the
# base docker-compose.yml's `env_file: [.env]` requirement is satisfied on a
# staging deploy the same way a contributor's own `.env` satisfies it
# locally. Fixed, non-secret staging values only — POSTGRES_PASSWORD is
# deliberately absent: it is never written to a file on the VPS, reaching
# containers only through the deploy SSH session's process environment
# (research.md §4, data-model.md).
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_PORT=5432
POSTGRES_DB=family_platform
