# Transferred to the VPS as `.env` (infrastructure/src/transfer.ts), so the
# base docker-compose.yml's `env_file: [.env]` requirement is satisfied on a
# staging deploy the same way a contributor's own `.env` satisfies it
# locally. Fixed, non-secret staging values only — POSTGRES_PASSWORD is
# deliberately absent: it is never written to a file on the VPS, reaching
# containers only through the deploy SSH session's process environment
# (research.md §4, data-model.md).
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_PORT=5432
POSTGRES_DB=family_platform

# Sweep cadences, at their defaults (spec 010 research.md §6). Present
# explicitly rather than left to the code's defaults so that an operator can
# see what the worker is doing, and change one, without reading the source.
# The worker validates every one of these at boot and refuses to start on a
# zero, a negative or a non-numeric value (Principle II).
SWEEP_ERASE_UNVERIFIED_INTERVAL_SECONDS=3600
SWEEP_ERASE_DELETED_ACCOUNTS_INTERVAL_SECONDS=3600
SWEEP_ERASE_STALE_SESSIONS_INTERVAL_SECONDS=3600
SWEEP_EXPIRE_INVITATIONS_INTERVAL_SECONDS=3600
SWEEP_GUARDIAN_COVERAGE_INTERVAL_SECONDS=86400
SWEEP_MATERIALISE_OCCURRENCES_INTERVAL_SECONDS=3600
# SC-012: overdue within five minutes, so this one runs every minute.
SWEEP_REPORT_OVERDUE_TASKS_INTERVAL_SECONDS=60
